function [solU, solDx, solDy, solF, solVx, solVy] = mySol(x,y)

global k1 k2 k3

X=mean(x);
Y=mean(y);

if Y>0.25
    k=k1;
end
if Y<0.25 && 



solU = 0*x + 0*y;
solDx = 0*x + 0*y;
solDy = 0*x + 0*y;
solF = -1/(1i*k)*exp(-(4*k/pi)^2*(x^2+y^2));   % OK
solVx = 1/(1i*k1*eta1) * solDx;                % OK
solVy = 1/(1i*k1*eta1) * solDy;                % OK

end